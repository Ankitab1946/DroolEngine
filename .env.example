# Copy to .env and edit for local development. NEVER commit real credentials.
# ENABLE_POSTGRES=false uses SQLite in the current working directory.
# ENABLE_POSTGRES=true uses PG_* settings below; DATABASE_URL is deliberately unused.
ENABLE_POSTGRES=false
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=dq
PG_SCHEMA=dq_app
POSTGRES_USER=dq
POSTGRES_PASSWORD=dq_local_only
POSTGRES_SSLMODE=prefer

# Set true only for a new, standalone DQ database in development.
# The current demo creates its OWN demo_*/dq_* tables under PG_SCHEMA.
# Do not point it at production until the real source adapter and migrations exist.
SEED_DEMO=true
EXECUTION_MODE=sync
API_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
DQ_API_KEY=local-demo-key-change-me

# Optional SMTP delivery
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_FROM=dq@example.org
# SMTP_USER=
# SMTP_PASSWORD=

# SQLite-only: use a NEW filename to start a fresh demo without deleting the old file.
# Ignored when ENABLE_POSTGRES=true.
SQLITE_DB_PATH=dq_demo.db
